# Copy to .env. It is git-ignored; this example file is not, so never put a
# real token here.

# The Open WebUI instance this proxy sits in front of. Required.
# Accepts a bare host, a host:port, or a full URL with a base path:
#   LLM_HOSTNAME=webui.example.com
#   LLM_HOSTNAME=webui.example.com:3000
#   LLM_HOSTNAME=http://127.0.0.1:3000
#   LLM_HOSTNAME=https://ai.example.com/openwebui/
LLM_HOSTNAME=http://127.0.0.1:3000

# An Open WebUI token used when a caller sends none, so a client that cannot
# hold a credential (VS Code with a placeholder key) still works. Get one from
# the UI: Settings -> Account -> API Keys, or your browser's localStorage.token.
WEBUI_TOKEN=

# A Cookie header sent upstream with every request, for an Open WebUI behind an
# SSO gateway that authenticates by session cookie instead of by bearer token --
# the symptom is a 401 from the gateway, not from Open WebUI, saying something
# like "no session ID found". Copy it from a browser that is logged in:
# F12 -> Application -> Cookies -> the session cookie, as name=value.
#   UPSTREAM_COOKIE=session=a1b2c3...
# A caller's own Cookie header wins over this one. Session cookies expire, so
# expect to refresh it; an API key does not, when the gateway accepts one.
UPSTREAM_COOKIE=

# true  = callers must present their own bearer token even when WEBUI_TOKEN is
#         set; the pinned token is then only the upstream credential.
# false = an unauthenticated caller is served on the pinned token.
REQUIRE_CLIENT_TOKEN=false

# https upstream only. The certificate is checked against the public roots in
# the image; an Open WebUI behind a company CA, or one whose server does not
# send its intermediate, fails that with "unable to get local issuer
# certificate". Point this at a PEM file on *this host* holding every
# certificate needed to bridge the gap -- the intermediate as well as the root
# if the server omits it, a root alone is not enough. It is mounted into the
# container read-only and trusted in addition to the public roots.
#
# `./init.sh --autocert` fills this in for you: it fetches the certificate, keeps
# it in proxy_stack_certs/ and writes the line below. `./init.sh --tls` explains
# what is wrong without changing anything.
#   UPSTREAM_CA_FILE=/etc/ssl/certs/company-chain.pem
UPSTREAM_CA_FILE=

# false = accept any upstream certificate. This drops the only check that the
# host answering is the one you named, so prefer UPSTREAM_CA_FILE; reach for
# this only against an instance you cannot get a CA for.
UPSTREAM_TLS_VERIFY=true

# Where this proxy listens. 127.0.0.1 keeps it off the network.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8111
