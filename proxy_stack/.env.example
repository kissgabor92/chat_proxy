# Copy to .env. It is git-ignored; this example file is not, so never put a
# real token here.

# The Open WebUI instance this proxy sits in front of. Required.
# Accepts a bare host, a host:port, or a full URL with a base path:
#   LLM_HOSTNAME=webui.example.com
#   LLM_HOSTNAME=webui.example.com:3000
#   LLM_HOSTNAME=http://127.0.0.1:3000
#   LLM_HOSTNAME=https://ai.example.com/openwebui/
LLM_HOSTNAME=http://127.0.0.1:3000

# An Open WebUI token used when a caller sends none, so a client that cannot
# hold a credential (VS Code with a placeholder key) still works. Get one from
# the UI: Settings -> Account -> API Keys, or your browser's localStorage.token.
WEBUI_TOKEN=

# true  = callers must present their own bearer token even when WEBUI_TOKEN is
#         set; the pinned token is then only the upstream credential.
# false = an unauthenticated caller is served on the pinned token.
REQUIRE_CLIENT_TOKEN=false

# Where this proxy listens. 127.0.0.1 keeps it off the network.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8111
