# Copy to .env. It is git-ignored by the repo-root .gitignore; this example
# file is not, so never put a real token here.

# The Open WebUI token the bridge uses upstream when a caller supplies none.
# This is the "provide the token beforehand" case: with it set, VS Code can be
# configured with any placeholder key. A caller's own token always wins, so
# per-user model permissions still apply.
#
#   UI:  Settings -> Account -> API Keys -> Create   (gives an sk-... key)
#   API: the `token` field of GET /api/v1/auths/
WEBUI_TOKEN=

# true  = a caller must present its own bearer token even when WEBUI_TOKEN is
#         set; the pinned token is then only the upstream credential.
# false = an unauthenticated caller is served on the pinned token. Convenient,
#         but anything that can reach port 8111 can then use the model.
REQUIRE_CLIENT_TOKEN=false
