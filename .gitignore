# Ollama model weights, left in place from the removed llm_stack: ~13 GB, and
# still bind-mounted by a running container. These must never enter git
# history, where they would be effectively unremovable.
/llm_stack/

__pycache__/
*.pyc

# IntelliJ output dir declared in .idea/misc.xml
/out/

# Local overrides and secrets
.env
.env.*
!.env.example
compose.override.yaml
compose.override.yml
